{
  "name": "telegram-harness-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "grammy": "1.46.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "description": "A durable Telegram bridge for console AI harnesses, starting with Codex.",
  "bin": {
    "thc": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "skills/telegram-history/SKILL.md",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "node scripts/test-live.ts",
    "prepack": "npm run build"
  }
}
