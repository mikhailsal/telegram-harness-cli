{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    "inlineSources": true,
    "declaration": true
  },
  "include": ["src"],
  "exclude": ["tests", "node_modules", "dist"]
}
